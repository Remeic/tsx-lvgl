#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

has_dry_run=0
has_execute=0
board_target=""
argument_index=1
for argument in "$@"; do
  if [[ "${argument}" == "--dry-run" ]]; then
    has_dry_run=1
  fi
  if [[ "${argument}" == "--execute" ]]; then
    has_execute=1
  fi
  if [[ "${argument}" == "--target" ]]; then
    next_index=$((argument_index + 1))
    if (( next_index > $# )); then
      echo "board-reload: --target requires a value" >&2
      exit 2
    fi
    if [[ -n "${board_target}" ]]; then
      echo "board-reload: --target may be supplied only once" >&2
      exit 2
    fi
    board_target="${!next_index}"
  elif [[ "${argument}" == --target=* ]]; then
    if [[ -n "${board_target}" ]]; then
      echo "board-reload: --target may be supplied only once" >&2
      exit 2
    fi
    board_target="${argument#--target=}"
  fi
  argument_index=$((argument_index + 1))
done

if [[ "${TSX_LVGL_SKIP_BUILD:-0}" != "1" && "${has_dry_run}" == "0" && "${has_execute}" == "1" ]]; then
  if [[ -z "${board_target}" ]]; then
    echo "board-reload: --target is required" >&2
    exit 2
  fi
  npm run board:build -- --target "${board_target}"
fi

exec node "${repo_root}/scripts/board-reload.mjs" "$@"
