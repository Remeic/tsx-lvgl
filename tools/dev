#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
image_name="tsx-lvgl-dev:local"
command_name="${1:-shell}"
shift || true

# Linked worktrees can point at Git metadata outside the repository mount. Pass
# only a read-only provenance snapshot; never expose the shared .git directory.
validation_git_sha="$(GIT_OPTIONAL_LOCKS=0 git -C "${repo_root}" rev-parse --verify HEAD)"
validation_git_status="$(GIT_OPTIONAL_LOCKS=0 git -C "${repo_root}" status --porcelain)"
if [[ -n "${validation_git_status}" ]]; then
  validation_git_state="dirty"
else
  validation_git_state="clean"
fi

# Always ask Docker to reconcile the local tag with the pinned Dockerfile. The
# build cache keeps this cheap while avoiding stale tools after a Dockerfile edit.
docker build --file "${repo_root}/.devcontainer/Dockerfile" --tag "${image_name}" "${repo_root}"

bootstrap_command='if [ ! -f node_modules/.package-lock.json ] || [ package-lock.json -nt node_modules/.package-lock.json ]; then npm ci --ignore-scripts --no-audit --no-fund; fi'

case "${command_name}" in
  shell)
    inner_command="bash"
    ;;
  test)
    inner_command="npm test"
    ;;
  mutation)
    inner_command="npm run mutation"
    ;;
  qemu)
    inner_command="${*:-idf.py qemu monitor}"
    ;;
  *)
    echo "usage: $0 [shell|test|mutation|qemu]" >&2
    exit 2
    ;;
esac

docker_run_args=(--rm)
if [[ -t 0 && -t 1 ]]; then
  docker_run_args+=(--interactive --tty)
fi

docker run "${docker_run_args[@]}" \
  --user "$(id -u):$(id -g)" \
  --env HOME=/tmp/tsx-lvgl-home \
  --env "TSX_LVGL_VALIDATION_GIT_SHA=${validation_git_sha}" \
  --env "TSX_LVGL_VALIDATION_GIT_STATE=${validation_git_state}" \
  --volume "${repo_root}:/workspace" \
  --workdir /workspace \
  "${image_name}" bash -lc "${bootstrap_command}; ${inner_command}"
