#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
image_name="tsx-lvgl-dev:local"
command_name="${1:-shell}"
shift || true

# Always ask Docker to reconcile the local tag with the pinned Dockerfile. The
# build cache keeps this cheap while avoiding stale tools after a Dockerfile edit.
docker build --file "${repo_root}/.devcontainer/Dockerfile" --tag "${image_name}" "${repo_root}"

bootstrap_command='if [ ! -f node_modules/.package-lock.json ] || [ package-lock.json -nt node_modules/.package-lock.json ]; then npm ci --ignore-scripts --no-audit --no-fund; fi'

case "${command_name}" in
  shell)
    inner_command="bash"
    ;;
  test)
    inner_command="npm test"
    ;;
  mutation)
    inner_command="npm run mutation"
    ;;
  c-compile)
    inner_command="npm run test:c"
    ;;
  simulator)
    inner_command="TSX_LVGL_SIMULATOR_BUILD_DIR=build/simulator-container npm run simulator:test"
    ;;
  esp-idf-v1)
    inner_command="npm run esp-idf:v1:build"
    ;;
  parity)
    inner_command="npm run generated:parity"
    ;;
  qemu)
    inner_command="${*:-idf.py qemu monitor}"
    ;;
  *)
    echo "usage: $0 [shell|test|mutation|c-compile|simulator|esp-idf-v1|parity|qemu]" >&2
    exit 2
    ;;
esac

docker_run_args=(--rm)
if [[ -t 0 && -t 1 ]]; then
  docker_run_args+=(--interactive --tty)
fi

docker run "${docker_run_args[@]}" \
  --user "$(id -u):$(id -g)" \
  --env HOME=/tmp/tsx-lvgl-home \
  --env IDF_TARGET=esp32s3 \
  --volume "${repo_root}:/workspace" \
  --workdir /workspace \
  "${image_name}" bash -lc "${bootstrap_command}; ${inner_command}"
