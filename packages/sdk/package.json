{
  "name": "@tsx-lvgl/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "The supported application facade and local CLI for TSX-LVGL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Remeic/tsx-lvgl.git"
  },
  "bugs": {
    "url": "https://github.com/Remeic/tsx-lvgl/issues"
  },
  "homepage": "https://github.com/Remeic/tsx-lvgl#readme",
  "keywords": [
    "tsx",
    "lvgl",
    "embedded",
    "esp32",
    "ui"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "bin": {
    "tsx-lvgl": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "provenance.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./package.json": "./package.json",
    "./provenance.json": "./provenance.json"
  },
  "dependencies": {
    "@tsx-lvgl/bundler": "0.1.0",
    "@tsx-lvgl/capabilities": "0.1.0",
    "@tsx-lvgl/connectivity": "0.1.0",
    "@tsx-lvgl/core": "0.1.0",
    "@tsx-lvgl/device": "0.1.0",
    "@tsx-lvgl/runtime": "0.1.0",
    "@tsx-lvgl/sensors": "0.1.0",
    "package-manager-detector": "1.8.0",
    "semver": "7.8.5",
    "typescript": "5.9.2"
  },
  "bundleDependencies": [
    "@tsx-lvgl/bundler",
    "@tsx-lvgl/capabilities",
    "@tsx-lvgl/connectivity",
    "@tsx-lvgl/core",
    "@tsx-lvgl/device",
    "@tsx-lvgl/runtime",
    "@tsx-lvgl/sensors",
    "package-manager-detector",
    "semver",
    "typescript"
  ]
}
