{
  "name": "@tsx-lvgl/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "The supported application facade and local CLI for TSX-LVGL",
  "type": "module",
  "bin": {
    "tsx-lvgl": "./dist/cli.js"
  },
  "files": [
    "dist",
    "provenance.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./package.json": "./package.json",
    "./provenance.json": "./provenance.json"
  },
  "dependencies": {
    "@tsx-lvgl/bundler": "0.1.0",
    "@tsx-lvgl/core": "0.1.0",
    "@tsx-lvgl/device": "0.1.0",
    "@tsx-lvgl/runtime": "0.1.0",
    "@tsx-lvgl/sensors": "0.1.0",
    "package-manager-detector": "1.8.0",
    "typescript": "5.9.2"
  },
  "bundledDependencies": [
    "@tsx-lvgl/bundler",
    "@tsx-lvgl/core",
    "@tsx-lvgl/device",
    "@tsx-lvgl/runtime",
    "@tsx-lvgl/sensors",
    "package-manager-detector",
    "typescript"
  ]
}
