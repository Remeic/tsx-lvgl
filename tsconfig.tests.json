{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "test-dist",
    "composite": true,
    "tsBuildInfoFile": "test-dist/tsconfig.tsbuildinfo",
    "jsx": "react-jsx",
    "jsxImportSource": "@tsx-lvgl/core",
    "types": ["node"]
  },
  "references": [
    { "path": "packages/core" },
    { "path": "packages/sensors" },
    { "path": "packages/runtime" },
    { "path": "packages/bundler" },
    { "path": "packages/device" }
  ],
  "include": ["tests/**/*.ts", "tests/**/*.tsx"]
}
