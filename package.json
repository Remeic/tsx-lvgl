{
  "name": "tsx-lvgl",
  "version": "0.1.0",
  "private": true,
  "description": "Typed TSX interfaces running on an on-device JavaScript runtime bound to native LVGL",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "board:build": "./tools/dev qemu \"cd examples/esp-idf/tsx_lvgl_v1 && idf.py build\"",
    "board:reload": "tools/board-reload",
    "test": "npm run coverage",
    "test:prepare": "node scripts/prepare-test-output.mjs && npm run build",
    "test:compiled": "node --test 'test-dist/tests/**/*.test.js' && node --test tests/*.test.mjs",
    "test:fast": "npm run test:prepare && npm run test:compiled",
    "coverage": "npm run test:prepare && node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test-coverage-include='packages/*/dist/**/*.js' 'test-dist/tests/**/*.test.js' && node --test tests/*.test.mjs",
    "mutation": "npm run test:prepare && stryker run",
    "check:fast": "npm run test:fast",
    "check:full": "npm test && npm run mutation",
    "validation:context": "node scripts/validation-context.mjs",
    "clean": "tsc -b --clean && rm -rf test-dist",
    "setup-hooks": "node scripts/install-git-hooks.mjs",
    "prepare": "npm run setup-hooks"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  },
  "overrides": {
    "qs": "6.15.3"
  }
}
